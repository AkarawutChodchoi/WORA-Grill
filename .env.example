# Copy to .env and adjust. Never commit real secrets. All values below are safe examples.

# --- Server ---
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Set to true only when the API runs behind your own reverse proxy (nginx/Caddy) that sets X-Forwarded-For.
TRUST_PROXY=false
# true when users reach the app over HTTPS (adds Secure cookies, HSTS, CSP upgrade-insecure-requests).
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
# Public URL used inside QR codes (table ordering, queue tickets).
PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---
# Leave empty to use the embedded PGlite database stored in PGLITE_DIR (single server, small shops).
# For production with several devices/branches use PostgreSQL 15+:
# DATABASE_URL=postgres://rms_app:CHANGE_ME@db.internal:5432/rms
DATABASE_URL=
PGLITE_DIR=./data/pglite
UPLOAD_DIR=./data/uploads

# --- Demo seed (development only; `npm run db:seed` refuses to run in production) ---
# SEED_OWNER_EMAIL=owner@demo.local
# SEED_OWNER_PASSWORD=choose-a-long-password
# SEED_STAFF_PIN=1357

# --- Optional integrations (stay disabled while empty) ---
# Opn Payments (Omise) — PromptPay with automatic confirmation
OPN_SECRET_KEY=
OPN_WEBHOOK_SECRET=
# OPN_API_BASE=https://api.omise.co
# Delivery-platform middleware → POST /api/webhooks/delivery/:provider signed with this secret
DELIVERY_WEBHOOK_SECRET=
# LINE Messaging API (staff alerts)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_TO=
# Print kitchen tickets automatically to configured LAN printers
AUTO_KITCHEN_PRINT=true
# Extra origins allowed to open the staff WebSocket (comma separated), e.g. a separate admin domain
# WS_ALLOWED_ORIGINS=
